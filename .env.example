# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://procureiq:procureiq_dev@localhost:5432/procureiq
SYNC_DATABASE_URL=postgresql://procureiq:procureiq_dev@localhost:5432/procureiq

# ── Embedding Provider ────────────────────────────────────────────────────────
# Default: "qwen" — Qwen3-Embedding-4B (2560d), same model as RAG-Entreprise.
# The model loads from your local HuggingFace cache (~/.cache/huggingface/)
# or via QWEN_BASE_URL (Ollama/vLLM/llama-server), and falls back cleanly if
# torch DLLs are unavailable on host Windows.
# Options: "qwen" | "local" (BGE-768) | "gemini" | "openai" | "hash"
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSION=2560
QWEN_BASE_URL=http://localhost:11434    # optional: Ollama/vLLM/llama-server endpoint
# BGE fallback (only used if EMBEDDING_PROVIDER=local)
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
LOCAL_EMBEDDING_DIMENSION=768
ALLOW_MODEL_DOWNLOADS=true
ENABLE_LOCAL_MODELS=true

# OpenAI embedding (only if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=

# ── LLM (Gemini) ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_VERIFY_SSL=false

# ── Agent Settings ────────────────────────────────────────────────────────────
TOOL_RETRIEVAL_TOP_K=5
MAX_SESSION_TURNS=20

# ── LangSmith Observability (optional but recommended for demo) ───────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=procureiq-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── PayPal API (optional — demo mocks work without credentials) ───────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
